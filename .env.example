# --- API Keys ---
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# --- Rate Limit & Processing Config ---
BATCH_SIZE=10
MAX_RETRIES=3
API_DELAY_SECONDS=4
CONFIDENCE_THRESHOLD=0.70
RUN_WORKER_COUNT=2
RUN_QUEUE_CAPACITY=8
MAX_ACTIVE_RUNS_PER_OWNER=2
MAX_TRANSACTIONS_PER_RUN=500
MAX_STRING_LENGTH=500
MAX_REQUEST_BODY_BYTES=1000000
REQUESTS_PER_MINUTE=120
MAX_PROVIDER_CALLS_PER_RUN=500
PROVIDER_CALL_ESTIMATED_COST_USD=0.01
MAX_ESTIMATED_PROVIDER_COST_USD=5.00
PROVIDER_TIMEOUT_SECONDS=30
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
RETRY_JITTER_RATIO=0.25
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
RAG_MAX_CONCURRENCY=3
RETRIEVAL_GRADING_CONCURRENCY=3
CATEGORY_CACHE_TTL_SECONDS=3600
MAX_RUN_LATENCY_SECONDS=300
LOG_LEVEL=info

# --- Deterministic Offline Demo ---
OFFLINE_DEMO_MODE=false

# --- Versioned Models and Local Storage ---
GEMINI_MODEL=gemini-3-flash-preview
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=all-MiniLM-L6-v2
TAX_CORPUS_VERSION=smartwealth-tax-corpus-v1
MINIMUM_RETRIEVAL_SCORE=0.45
CHECKPOINT_PATH=checkpoints.sqlite
CHROMA_PATH=data/chroma_db
PDF_DIR=data/tax_corpus/raw_pdfs
ALLOWED_DATA_ROOT=data
RUN_STORAGE_MODE=session
RUN_RETENTION_HOURS=24

# Development/test leave these empty and use SQLite + Chroma. ENVIRONMENT=production
# requires all PostgreSQL URLs and defaults VECTOR_BACKEND to pgvector.
# Never commit credentials or real URLs.
RUN_DATABASE_URL=
CHECKPOINT_DATABASE_URL=
# Optional override. Default is chroma outside production and pgvector in production.
# VECTOR_BACKEND=chroma
VECTOR_DATABASE_URL=
VECTOR_COLLECTION=smartwealth_tax_corpus

# --- API Boundary ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1
FORCE_HTTPS=false
ENVIRONMENT=development
