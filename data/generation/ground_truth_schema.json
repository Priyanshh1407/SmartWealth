{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartwealth.local/schemas/ground-truth-v2.json",
  "title": "SmartWealth Ground Truth",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_version",
    "seed",
    "transactions"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "minLength": 1
    },
    "seed": {
      "type": "integer"
    },
    "transactions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction_id",
          "true_category",
          "expected_treatment",
          "expected_allowed_fraction",
          "section",
          "has_receipt"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "pattern": "^TXN-[0-9]+$"
          },
          "true_category": {
            "enum": [
              "Software Subscriptions",
              "Travel & Transit",
              "Business Meals",
              "Entertainment",
              "Office Supplies",
              "Hardware & Equipment",
              "Professional Fees",
              "Telephone & Internet",
              "Unknown"
            ]
          },
          "expected_treatment": {
            "enum": [
              "deductible",
              "non_deductible",
              "depreciable",
              "partially_deductible",
              "undetermined"
            ]
          },
          "expected_allowed_fraction": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "section": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "has_receipt": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
